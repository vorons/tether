# Vendored libcurl — minimal HTTPS/TLS build (no autotools)
#
# Builds a static archive libcurl_vend.a with mbedTLS as the TLS backend.
# Protocol support: http/https only (sufficient for tether's API calls).
#
# Usage (from top-level Makefile):
#   $(MAKE) -C vendor/curl -f Makefile.curl

VEND      := $(abspath $(CURDIR)/..)
OBJDIR    := $(VEND)/curl_build/obj
ARCHIVE   := $(VEND)/curl_build/libcurl_vend.a

CC        ?= gcc

INC       := -I$(CURDIR)/include \
             -I$(CURDIR)/lib \
             -I$(VEND)/mbedtls/include \
             -I$(VEND)/zlib

DEFINES   := -DUSE_MBEDTLS=1 \
             -DCURL_DISABLE_PROXY=1 \
             -DCURL_DISABLE_FTP=1 \
             -DCURL_DISABLE_IMAP=1 \
             -DCURL_DISABLE_POP3=1 \
             -DCURL_DISABLE_SMTP=1 \
             -DCURL_DISABLE_TFTP=1 \
             -DCURL_DISABLE_GOPHER=1 \
             -DCURL_DISABLE_SMB=1 \
             -DCURL_DISABLE_DICT=1 \
             -DCURL_DISABLE_MQTT=1 \
             -DCURL_DISABLE_TELNET=1 \
             -DCURL_DISABLE_RTSP=1 \
             -DCURL_DISABLE_SSH=1 \
             -DCURL_DISABLE_LDAP=1 \
             -DCURL_DISABLE_PAM=1 \
             -DCURL_DISABLE_PROGRESS_METER=1

# -std=gnu11 (not c11): the hand-crafted curl_config.h does not set a POSIX
# feature macro, so under -std=c11 glibc hides struct sigaction and friends
# and curl's own sources stop compiling.
# _GNU_SOURCE is what curl's own ./configure adds: curl_config.h declares
# HAVE_GLIBC_STRERROR_R, which only exists in glibc's GNU strerror_r variant.
CFLAGS    := -std=gnu11 -O2 -fPIC -w -D_GNU_SOURCE -DHAVE_CONFIG_H=1 $(INC) $(DEFINES)

# --- Core source files (lib/) --------------------------------------------
SRCS := \
  lib/altsvc.c \
  lib/base64.c \
  lib/bufq.c \
  lib/bufref.c \
  lib/cf-h1-proxy.c \
  lib/cf-haproxy.c \
  lib/cfilters.c \
  lib/cf-socket.c \
  lib/conncache.c \
  lib/connect.c \
  lib/content_encoding.c \
  lib/cookie.c \
  lib/cshutdn.c \
  lib/curl_addrinfo.c \
  lib/curl_des.c \
  lib/curl_endian.c \
  lib/curl_fnmatch.c \
  lib/curl_gethostname.c \
  lib/curl_get_line.c \
  lib/curl_gssapi.c \
  lib/curl_memrchr.c \
  lib/curl_multibyte.c \
  lib/curl_ntlm_core.c \
  lib/curl_range.c \
  lib/curl_rtmp.c \
  lib/curl_sasl.c \
  lib/curl_sha512_256.c \
  lib/curl_threads.c \
  lib/curl_trc.c \
  lib/cw-out.c \
  lib/cw-pause.c \
  lib/doh.c \
  lib/dynbuf.c \
  lib/dynhds.c \
  lib/easy.c \
  lib/easygetopt.c \
  lib/easyoptions.c \
  lib/escape.c \
  lib/file.c \
  lib/fileinfo.c \
  lib/fopen.c \
  lib/formdata.c \
  lib/getenv.c \
  lib/getinfo.c \
  lib/hash.c \
  lib/hash_offt.c \
  lib/headers.c \
  lib/hmac.c \
  lib/hostasyn.c \
  lib/hostip4.c \
  lib/hostip6.c \
  lib/hostip.c \
  lib/hostsyn.c \
  lib/hsts.c \
  lib/http1.c \
  lib/http.c \
  lib/http_chunks.c \
  lib/http_digest.c \
  lib/http_negotiate.c \
  lib/http_ntlm.c \
  lib/http_proxy.c \
  lib/httpsrr.c \
  lib/if2ip.c \
  lib/inet_ntop.c \
  lib/inet_pton.c \
  lib/llist.c \
  lib/md4.c \
  lib/md5.c \
  lib/memdebug.c \
  lib/mime.c \
  lib/mprintf.c \
  lib/multi.c \
  lib/multi_ev.c \
  lib/netrc.c \
  lib/nonblock.c \
  lib/noproxy.c \
  lib/parsedate.c \
  lib/pingpong.c \
  lib/progress.c \
  lib/rand.c \
  lib/rename.c \
  lib/request.c \
  lib/select.c \
  lib/sendf.c \
  lib/setopt.c \
  lib/sha256.c \
  lib/share.c \
  lib/slist.c \
  lib/socketpair.c \
  lib/socks.c \
  lib/socks_gssapi.c \
  lib/speedcheck.c \
  lib/splay.c \
  lib/strcase.c \
  lib/strdup.c \
  lib/strequal.c \
  lib/strerror.c \
  lib/strparse.c \
  lib/timediff.c \
  lib/timeval.c \
  lib/transfer.c \
  lib/urlapi.c \
  lib/url.c \
  lib/version.c \
  lib/warnless.c \
  lib/ws.c \
  lib/vauth/cleartext.c \
  lib/vauth/cram.c \
  lib/vauth/digest.c \
  lib/vauth/ntlm.c \
  lib/vauth/oauth2.c \
  lib/vauth/vauth.c \
  lib/vtls/cipher_suite.c \
  lib/vtls/hostcheck.c \
  lib/vtls/keylog.c \
  lib/vtls/mbedtls.c \
  lib/vtls/mbedtls_threadlock.c \
  lib/vtls/vtls.c \
  lib/vtls/vtls_scache.c \
  lib/vtls/vtls_spack.c

# The curated list above omitted several translation units (cf-https-connect.c,
# idn.c, http_aws_sigv4.c, curl_ctype.c, ...), which left undefined references
# at link time. Derive the list from the tree instead.
SRCS := $(wildcard lib/*.c lib/*/*.c)

# mbedTLS 3.6 compat shim
SRCS_SHIM := $(VEND)/curl_build/mbedtls_compat.c

# SRCS entries are relative to this directory (lib/foo.c), so map them straight
# onto the object directory; filtering on $(CURDIR) here silently produced an
# empty object list and an archive containing only the compat shim.
OBJS := $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS))
OBJS += $(OBJDIR)/.mbedtls_compat.o

.PHONY: all clean
all: $(ARCHIVE)

$(ARCHIVE): $(OBJS) | $(OBJDIR)
	ar rcs $@ $(OBJS)
	@echo "=== $(ARCHIVE) ==="
	ls -la $@

$(OBJDIR)/%.o: %.c | $(OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/.mbedtls_compat.o: $(SRCS_SHIM) | $(OBJDIR)
	$(CC) $(CFLAGS) -I$(VEND)/mbedtls/include -c $< -o $@

$(OBJDIR):
	@mkdir -p $(OBJDIR)

clean:
	rm -rf $(OBJDIR) $(ARCHIVE)
